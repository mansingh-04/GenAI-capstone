# Environment Variables for FastAPI Backend (Server)
# Copy this to .env in the milestone2 directory when running the FastAPI server
# Backend needs all of these variables to run the fact-checking agent

# ── LLM Configuration (Required) ──────────────────────────────────────────
# The LLM provider to use for the reasoning agent
LLM_TYPE=groq

# Groq API Key - Get from https://console.groq.com
# Required if LLM_TYPE=groq
GROQ_API_KEY=your_groq_api_key_here

# Groq Model name (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── News API Configuration (Required) ────────────────────────────────────
# NewsAPI key for fetching live news articles - Get from https://newsapi.org
NEWSAPI_KEY=your_newsapi_key_here

# ── Authentication (Required) ────────────────────────────────────────────
# Shared API secret key between FastAPI backend and Streamlit frontend.
# MUST match the API_SECRET_KEY value in your frontend .env file.
# Change this before deploying to production.
API_SECRET_KEY=change_me_before_deploying

# ── API Server Configuration (Optional) ──────────────────────────────────
# Server host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# Port for the FastAPI server
API_PORT=8000

# Enable debug mode with auto-reload on file changes (use False in production)
API_DEBUG=False

# ── Frontend Connection (Optional, for deployment) ──────────────────────
# URL where the Streamlit frontend is running (used for CORS if on different server)
# For local development: not needed (defaults to http://localhost:8501)
# For production: set to your Streamlit frontend URL
UI_BACKEND_HOST=http://localhost:8000

# ── Logging Configuration (Optional) ────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
