# Environment Variables for Streamlit Frontend (UI)
# Copy this to .env in the milestone2 directory when running the Streamlit app
# The frontend only needs these two variables to communicate with the FastAPI backend

# ── Backend Connection (Required) ────────────────────────────────────────
# URL where the FastAPI backend is running.
# For local development: http://localhost:8000
# For production: https://your-backend-domain.com
UI_BACKEND_HOST=http://localhost:8000

# ── Authentication (Required) ────────────────────────────────────────────
# Shared API secret key between Streamlit frontend and FastAPI backend.
# MUST match the API_SECRET_KEY value in your backend .env file.
# Change this before deploying to production.
API_SECRET_KEY=change_me_before_deploying
