# Environment Variables Template
# Copy this file to .env and fill in the required values

# ── LLM (Required) ──────────────────────────────────────────
LLM_TYPE=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── News API (Required) ──────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ── Authentication (Required) ────────────────────────────────
# Internal API key shared between Streamlit and FastAPI. Change before deploying.
API_SECRET_KEY=change_me_before_deploying

# ── Backend URL (for deployment) ─────────────────────────────
# If Streamlit and FastAPI run on different servers, set this to the FastAPI base URL.
# Default (localhost dev): http://localhost:8000
UI_BACKEND_HOST=http://localhost:8000

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
