# Environment Variables Template
# 
# ⚠️  IMPORTANT: This project has split environment templates:
# - .env.backend.example  ← Use this for FastAPI backend
# - .env.frontend.example ← Use this for Streamlit UI
#
# Copy the appropriate template file to .env based on what you're running:
#   Backend: cp .env.backend.example .env
#   Frontend: cp .env.frontend.example .env
#
# Below is a COMBINED reference for all possible environment variables.

# ── LLM (Required for backend) ──────────────────────────────────────────
LLM_TYPE=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── News API (Required for backend) ──────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ── Authentication (Required for both backend and frontend) ────────────────
# Internal API key shared between Streamlit and FastAPI. Change before deploying.
API_SECRET_KEY=change_me_before_deploying

# ── Backend URL (Required for frontend) ──────────────────────────────────
# If Streamlit and FastAPI run on different servers, set this to the FastAPI base URL.
# Default (localhost dev): http://localhost:8000
UI_BACKEND_HOST=http://localhost:8000

# ── API Server (Optional for backend) ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# ── Logging (Optional for backend) ──────────────────────────────────────
LOG_LEVEL=INFO
